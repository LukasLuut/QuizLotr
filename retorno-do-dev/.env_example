PORT=3000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=sua_senha
DB_NAME=quiz_lotr
# true para logar todas as queries SQL (expõe parâmetros: use só para depurar)
DB_LOGGING=false

BCRYPT_SALT_ROUNDS=10

# Gere um segredo longo e aleatório, ex.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque_por_um_segredo_longo
JWT_EXPIRES_IN=86400

# Origens do frontend liberadas no CORS, separadas por vírgula
CORS_ORIGIN=http://localhost:5173
